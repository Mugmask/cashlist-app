# Copy this file to .env.local and fill it in with your Supabase project values
# (Project Settings → API). Never put the service_role key here.
# Only builds and `pnpm dev:prod` use it: `pnpm dev` runs in local mode (.env.development) and
# `pnpm dev:sync` against the local Supabase.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
