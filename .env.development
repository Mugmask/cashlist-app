# `pnpm dev` runs in local mode, with the demo data: development never writes to production.
# This file beats .env.local in dev only (builds still use .env.local). Against the local
# Supabase: `pnpm dev:sync`. Against production, on purpose: `pnpm dev:prod`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
